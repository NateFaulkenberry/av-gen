{
  "format": "avgen-render-queue", "version": 1,
  "_note": "Brief §29's six comparison renders, §11's Glowmere ladder, and two ADR-182 controls. Paths are relative to this file so the queue runs from any checkout. Pixels are not committed; this file regenerates all of them: ./build/release/src/avgen --headless --queue renders/treeisland/stills.json",
  "jobs": [
    { "_arm": "29-1 -- the scene as ADR-338 merged it, before this pass",
      "project": "../../examples/treeisland/_compare-original.json",
      "render": { "output": "sequence", "path": "../../renders/treeisland/before-original", "pattern": "before_{:04d}.png",
                  "width": 1920, "height": 1080, "fps": 1, "start": 0.0, "end": 0.5,
                  "tier": "offline", "limits": "unlimited", "supersample": 2.0 } },

    { "_arm": "29-2 / 11-structural -- Glowmere disabled, every emissiveBoost at 0",
      "project": "../../examples/treeisland/_glow-off.json",
      "render": { "output": "sequence", "path": "../../renders/treeisland/glow-off", "pattern": "off_{:04d}.png",
                  "width": 1920, "height": 1080, "fps": 1, "start": 0.0, "end": 0.5,
                  "tier": "offline", "limits": "unlimited", "supersample": 2.0 } },

    { "_arm": "11-low -- 0.4x the shipping channels",
      "project": "../../examples/treeisland/_glow-low.json",
      "render": { "output": "sequence", "path": "../../renders/treeisland/glow-low", "pattern": "low_{:04d}.png",
                  "width": 1920, "height": 1080, "fps": 1, "start": 0.0, "end": 0.5,
                  "tier": "offline", "limits": "unlimited", "supersample": 2.0 } },

    { "_arm": "29-3 / 29-4 / 11-normal -- the shipping state",
      "project": "../../examples/treeisland/tree-of-life-floating-island.json",
      "render": { "output": "sequence", "path": "../../renders/treeisland/hero", "pattern": "hero_{:04d}.png",
                  "width": 1920, "height": 1080, "fps": 1, "start": 0.0, "end": 0.5,
                  "tier": "offline", "limits": "unlimited", "supersample": 2.0 } },

    { "_arm": "11-high -- 3x the shipping channels; the bloom check",
      "project": "../../examples/treeisland/_glow-high.json",
      "render": { "output": "sequence", "path": "../../renders/treeisland/glow-high", "pattern": "high_{:04d}.png",
                  "width": 1920, "height": 1080, "fps": 1, "start": 0.0, "end": 0.5,
                  "tier": "offline", "limits": "unlimited", "supersample": 2.0 } },

    { "_arm": "29-5 -- alternate rotation: the same project 60 s in, 120 degrees round",
      "project": "../../examples/treeisland/tree-of-life-floating-island.json",
      "render": { "output": "sequence", "path": "../../renders/treeisland/alt-rotation", "pattern": "rot_{:04d}.png",
                  "width": 1920, "height": 1080, "fps": 1, "start": 60.0, "end": 60.5,
                  "tier": "offline", "limits": "unlimited", "supersample": 2.0 } },

    { "_arm": "29-6 -- low angle / underside: no root escapes, and the island really floats",
      "project": "../../examples/treeisland/_view-low-angle.json",
      "render": { "output": "sequence", "path": "../../renders/treeisland/low-angle", "pattern": "low_{:04d}.png",
                  "width": 1920, "height": 1080, "fps": 1, "start": 0.0, "end": 0.5,
                  "tier": "offline", "limits": "unlimited", "supersample": 2.0 } },

    { "_arm": "12/15 -- the root/soil transition, close",
      "project": "../../examples/treeisland/_view-contact.json",
      "render": { "output": "sequence", "path": "../../renders/treeisland/contact", "pattern": "contact_{:04d}.png",
                  "width": 1920, "height": 1080, "fps": 1, "start": 0.0, "end": 0.5,
                  "tier": "offline", "limits": "unlimited", "supersample": 2.0 } },

    { "_arm": "ADR-182 control -- the cosmos background shader removed, nothing else changed",
      "project": "../../examples/treeisland/_ctl-no-cosmos-shader.json",
      "render": { "output": "sequence", "path": "../../renders/treeisland/ctl-no-cosmos", "pattern": "noc_{:04d}.png",
                  "width": 1920, "height": 1080, "fps": 1, "start": 0.0, "end": 0.5,
                  "tier": "offline", "limits": "unlimited", "supersample": 2.0 } },

    { "_arm": "ADR-182 control -- star and mote shells removed; what they cost the shadow cascades",
      "project": "../../examples/treeisland/_ctl-no-stars.json",
      "render": { "output": "sequence", "path": "../../renders/treeisland/ctl-no-stars", "pattern": "nos_{:04d}.png",
                  "width": 1920, "height": 1080, "fps": 1, "start": 0.0, "end": 0.5,
                  "tier": "offline", "limits": "unlimited", "supersample": 2.0 } },

    { "_arm": "the hierarchy in pixels -- five stills across one revolution",
      "project": "../../examples/treeisland/tree-of-life-floating-island.json",
      "render": { "output": "sequence", "path": "../../renders/treeisland/rotation-stills", "pattern": "turn_{:04d}.png",
                  "width": 1280, "height": 720, "fps": 0.027777778, "start": 0.0, "end": 150.0,
                  "tier": "offline", "limits": "unlimited", "supersample": 1.0 } }
  ]
}
