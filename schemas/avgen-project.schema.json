        },
        "curveAmount": {
          "type": "number"
        },
        "decayMs": {
          "type": "number"
        },
        "delayMs": {
          "description": "ADR-900.",
          "minimum": 0.0,
          "type": "number"
        },
        "envelope": {
          "enum": [
            "none",
            "peakhold",
            "linearfall"
          ],
