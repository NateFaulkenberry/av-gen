        },
        "integrateMax": {
          "type": "number"
        },
        "integrateMin": {
          "type": "number"
        },
        "normalizeFloor": {
          "type": "number"
        },
        "normalizeSeconds": {
          "description": "ADR-1182; 0 is off.",
          "maximum": 3600.0,
          "minimum": 0.0,
          "type": "number"
        },
        "normalizeSmoothMs": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "remapEnabled": {
          "type": "boolean"
        },
        "remapInMax": {
          "type": "number"
        },
        "remapInMin": {
          "type": "number"
        },
        "remapOutMax": {
          "type": "number"
        },
        "remapOutMin": {
          "type": "number"
        },
        "springDamping": {
          "minimum": 0.0,
          "type": "number"
        },
        "springHz": {
          "description": "ADR-1041; 0 is off.",
          "minimum": 0.0,
          "type": "number"
        },
        "threshold": {
          "enum": [
            "none",
            "gate",
            "binary",
            "subtract"
          ],
          "type": "string"
        },
        "thresholdLevel": {
          "type": "number"
        },
        "trendFastMs": {
          "type": "number"
        },
        "trendFloor": {
          "type": "number"
        },
        "trendSeconds": {
          "type": "number"
        }
      },
      "type": "object",
      "x-avgen-unknownKeys": "drop"
    },
    "material": {
