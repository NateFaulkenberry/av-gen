{
  "$defs": {
    "assetRef": {
      "anyOf": [
        {
          "description": "A path relative to the project file (the older form, still read).",
          "type": "string"
        },
        {
          "additionalProperties": true,
          "properties": {
            "path": {
              "description": "Relative to the project file.",
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "size": {
              "description": "Bytes; with sha256, relinks a moved file.",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "path"
          ],
          "type": "object",
          "x-avgen-unknownKeys": "drop"
        }
      ],
      "description": "A file the project names. A missing file is searched for under the project folder by name, size and hash."
    },
    "assets": {
      "additionalProperties": true,
      "properties": {
        "audio": {
          "$ref": "#/$defs/assetRef"
        },
        "audioClips": {
          "description": "An arrangement; wins over `audio` (never both written).",
          "items": {
            "additionalProperties": true,
            "properties": {
              "duration": {
                "type": "number"
              },
              "enabled": {
                "type": "boolean"
              },
              "fadeIn": {
                "type": "number"
              },
              "fadeOut": {
                "type": "number"
              },
              "file": {
                "$ref": "#/$defs/assetRef"
              },
              "gain": {
                "type": "number"
              },
              "in": {
                "description": "Seconds into the file.",
                "type": "number"
              },
              "name": {
                "type": "string"
              },
              "start": {
                "description": "Seconds on the timeline.",
                "type": "number"
              }
            },
            "required": [
              "file"
            ],
            "type": "object",
            "x-avgen-unknownKeys": "drop"
          },
          "type": "array"
        },
        "environment": {
          "$ref": "#/$defs/assetRef"
        },
        "scene": {
          "additionalProperties": true,
          "properties": {
            "inline": {
              "additionalProperties": true,
              "description": "A whole scene document (avgen-scene.schema.json).",
              "type": "object"
            },
            "kind": {
              "description": "The three kinds Engine::loadProject branches on; orb when absent.",
              "enum": [
                "orb",
                "gltf",
                "composition"
              ],
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/assetRef"
            }
          },
          "type": "object",
          "x-avgen-unknownKeys": "drop"
        },
        "stems": {
          "description": "ADR-1520: analysis stems.",
          "items": {
            "additionalProperties": true,
            "properties": {
              "file": {
                "$ref": "#/$defs/assetRef"
              },
              "gainDb": {
                "description": "Clamped to the analysis trim range.",
                "type": "number"
              },
              "key": {
                "description": "The stem's signal key: stem.<key>.*.",
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "offset": {
                "description": "Seconds.",
                "type": "number"
              },
              "role": {
                "description": "ADR-1630: what the stem is. Any other value is read as other, with a warning.",
                "enum": [
                  "drums",
                  "bass",
                  "synth",
                  "vocal",
                  "other"
                ],
                "type": "string"
              }
            },
            "required": [
              "file"
            ],
            "type": "object",
            "x-avgen-unknownKeys": "drop"
          },
          "type": "array"
        }
      },
      "type": "object",
      "x-avgen-unknownKeys": "drop"
    },
    "chain": {
      "additionalProperties": true,
      "properties": {
        "attackMs": {
          "type": "number"
        },
        "clampEnabled": {
          "type": "boolean"
        },
        "clampMax": {
          "type": "number"
        },
        "clampMin": {
          "type": "number"
        },
        "curve": {
