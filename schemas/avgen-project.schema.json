        },
        "extraLane": {
          "x-avgen-untyped": true
        },
        "flatFarRungs": {
          "x-avgen-untyped": true
        },
        "grammar": {
          "x-avgen-untyped": true
        },
        "hierarchy": {
          "x-avgen-untyped": true
        },
        "lod": {
          "x-avgen-untyped": true
        },
        "material": {
