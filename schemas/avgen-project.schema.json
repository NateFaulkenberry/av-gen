        "name": {
          "description": "Sanitised (`.`, `/` and space become `_`) and made unique.",
          "type": "string"
        },
        "opacity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "parent": {
          "description": "Another node's name.",
          "type": "string"
        },
        "position": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "procedural": {
          "$ref": "#/$defs/procedural"
        },
        "program": {
          "description": "ADR-1572.",
          "type": "string"
        },
        "rotation": {
          "description": "Euler degrees. Written back as Euler degrees from a quaternion (ADR-2151).",
