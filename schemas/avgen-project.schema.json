  "$id": "avgen-project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "An AV Gen project document, format version 4. Generated by `avgen --describe schema:project` (ADR-2152): the keys are the engine's own key lists, the types its typing table. A block marked x-avgen-untyped is read by the engine but not typed here yet. Unknown top-level keys are kept verbatim (ADR-2132).",
  "properties": {
    "app": {
      "additionalProperties": true,
      "description": "The writer's stamp, replaced on every save (api::version()).",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "type": "object",
      "x-avgen-unknownKeys": "drop"
    },
    "assets": {
      "$ref": "#/$defs/assets"
    },
    "atmosphericEffects": {
      "description": "Refused at load (pre-ADR-702).",
      "x-avgen-untyped": true
    },
    "autoDirector": {
      "description": "Director state.",
      "x-avgen-untyped": true
    },
    "cameraAimFollow": {
      "description": "Director state.",
      "x-avgen-untyped": true
    },
    "cameraContinuousTake": {
      "description": "Director state.",
      "x-avgen-untyped": true
    },
    "cameraDirection": {
      "x-avgen-untyped": true
    },
    "cameraShotSpans": {
      "description": "Director state.",
      "x-avgen-untyped": true
    },
    "composition": {
      "x-avgen-untyped": true
    },
    "control": {
      "x-avgen-untyped": true
    },
    "directingEvaluations": {
      "description": "Director state.",
      "x-avgen-untyped": true
    },
    "directingPlans": {
      "description": "Director state.",
      "x-avgen-untyped": true
    },
    "director": {
      "x-avgen-untyped": true
    },
    "effects": {
      "description": "The session's effects, over the scene's (ADR-702).",
      "x-avgen-untyped": true
    },
    "feeds": {
      "description": "ADR-1580: which sources feed analysis.",
      "x-avgen-untyped": true
    },
    "format": {
      "const": "avgen-project"
    },
    "heroes": {
      "description": "The session's heroes, when they differ from the scene file's.",
      "x-avgen-untyped": true
    },
    "lights": {
      "description": "The session's authored lights, when they differ from the scene file's.",
      "x-avgen-untyped": true
    },
    "live": {
      "description": "ADR-1100: the live block.",
      "x-avgen-untyped": true
    },
    "outputs": {
