        },
        "emissiveBoost": {
          "type": "number"
        },
        "energy": {
          "x-avgen-untyped": true
        },
        "float": {
          "x-avgen-untyped": true
        },
        "importance": {
          "enum": [
            "hero",
            "foreground",
            "normal",
            "background",
            "ambient"
          ],
          "type": "string"
        },
        "journey": {
          "description": "ADR-1042: {distance}.",
          "x-avgen-untyped": true
        },
        "kind": {
          "enum": [
            "gltf",
            "orb",
            "grid",
            "particles",
            "scene",
            "procedural",
            "field",
            "spline",
            "sdf",
            "terrain",
            "group",
            "city"
          ],
          "type": "string"
        },
        "locked": {
          "type": "boolean"
        },
        "material": {
          "$ref": "#/$defs/material"
