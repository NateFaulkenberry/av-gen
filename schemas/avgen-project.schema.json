        },
        "unlit": {
          "description": "Procedural only.",
          "type": "boolean"
        },
        "wire": {
          "description": "ADR-1073.",
          "x-avgen-untyped": true
        }
      },
      "type": "object",
      "x-avgen-unknownKeys": "drop"
    },
    "node": {
      "additionalProperties": true,
      "anyOf": [
        {
          "description": "gltf: a glTF asset.",
          "properties": {
            "animation": {
              "description": "ADR-086: a skinned character's opening state.",
              "x-avgen-untyped": true
            },
            "kind": {
              "const": "gltf"
            },
            "lod": {
              "additionalProperties": false,
              "description": "ADR-351; an unknown key is refused.",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "hysteresis": {
                  "type": "number"
                },
                "maxScreenError": {
                  "type": "number"
                },
                "ratios": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "thinning": {
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "waterMaterials": {
              "description": "ADR-2020: glTF material name -> water.",
              "x-avgen-untyped": true
            }
          }
        },
        {
          "description": "group: an empty transform that parents other nodes.",
          "properties": {
            "kind": {
              "const": "group"
            }
          }
        },
        {
          "description": "procedural: geometry from the `procedural` block.",
          "properties": {
            "kind": {
              "const": "procedural"
            }
          }
        },
        {
          "description": "Every other kind: its own blocks (world, terrain, scatter, particles, ...) are not typed.",
          "properties": {
            "kind": {
              "enum": [
                "orb",
                "grid",
                "particles",
                "scene",
                "field",
                "spline",
                "sdf",
                "terrain",
                "city"
              ],
              "type": "string"
            }
          },
          "x-avgen-untyped": true
        }
      ],
      "description": "A scene node. A key the parser does not read is dropped on save; `_` keys are kept.",
      "properties": {
        "asset": {
          "description": "A path relative to the scene file, or an asset:// id.",
          "type": "string"
        },
        "bob": {
          "description": "A cloud formation's name (ADR-2112).",
          "type": "string"
        },
        "canopyFrom": {
          "x-avgen-untyped": true
        },
        "canopySource": {
          "x-avgen-untyped": true
        },
