      "x-avgen-untyped": true
    },
    "post": {
      "$ref": "#/$defs/post"
    },
    "staging": {
      "description": "Staging (stage::stagingFromJson).",
      "x-avgen-untyped": true
    },
    "version": {
      "const": 1,
      "description": "Any other version is refused."
    },
    "wind": {
      "additionalProperties": true,
      "description": "The weather (ADR-055); its keys are not typed yet.",
      "type": "object",
      "x-avgen-unknownKeys": "drop",
      "x-avgen-untyped": true
    },
    "worldEvents": {
      "x-avgen-untyped": true
    }
  },
  "required": [
    "format",
    "version"
  ],
  "title": "AV Gen scene",
  "type": "object",
  "x-avgen-api": 2,
  "x-avgen-notWrittenBack": [
    {
      "note": "written back as environment.lightRig, which the parser also reads",
      "pointer": "/lightRig"
    },
    {
      "note": "an empty list is written as absent, which means the same",
      "pointer": "/lights"
    },
    {
      "note": "an empty list is written as absent, which means the same",
      "pointer": "/heroes"
    },
    {
      "note": "an empty list is written as absent, which means the same",
      "pointer": "/entities"
    },
    {
      "note": "migrated to an effect instance in `effects` (ADR-441); not written back here",
      "pointer": "/environment/vortex"
    },
    {
      "note": "a node key the parser does not read is dropped on save (only `_` keys are kept): nodes have no key list yet (ADR-2151, reported)",
      "pointer": "/nodes/*/<unknown>"
    },
    {
      "note": "an empty list is written as absent, and a world read without the key gets the default biomes (src/world/world_map.cpp worldMapToJson; ADR-2151, reported)",
      "pointer": "/nodes/*/world/biomes"
    }
  ],
  "x-avgen-unknownKeys": "warn"
}
