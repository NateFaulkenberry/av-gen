  "$id": "avgen-scene.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "An AV Gen scene document, format version 1. Generated by `avgen --describe schema:scene` (ADR-2152): the keys are the parser's own key lists, the types its typing table. A block marked x-avgen-untyped is read by the engine but not typed here yet. An unknown top-level key is warned about at load and kept on save (ADR-2151); x-avgen-unknownKeys says what each object does with one, and x-avgen-notWrittenBack lists what a save does not write back as read.",
  "properties": {
    "astral": {
      "description": "ADR-1221.",
      "x-avgen-untyped": true
    },
    "attractorWorld": {
      "description": "ADR-1850.",
      "x-avgen-untyped": true
    },
    "camera": {
      "$ref": "#/$defs/camera"
    },
    "cameraDirection": {
      "description": "The scene's camera rig and shots (CameraDirection::fromJson).",
      "x-avgen-untyped": true
    },
    "clouds": {
      "description": "ADR-1289.",
      "x-avgen-untyped": true
    },
    "composition": {
      "description": "The 2D composition layer (CompositionData::fromJson).",
      "x-avgen-untyped": true
    },
    "corruption": {
      "description": "ADR-1873.",
      "x-avgen-untyped": true
    },
    "crowd": {
      "description": "ADR-2225: the navigated crowd (crowd::crowdFromJson): groups, walls, a time-keyed schedule.",
      "x-avgen-untyped": true
    },
    "ecosystem": {
      "description": "ADR-1200.",
      "x-avgen-untyped": true
    },
    "effects": {
      "description": "Authored world effects (ADR-702).",
      "x-avgen-untyped": true
    },
    "entities": {
      "description": "Entities (entity::entitiesFromJson).",
      "x-avgen-note": "an empty list is written as absent, which means the same",
      "x-avgen-untyped": true,
      "x-avgen-writtenBack": false
    },
    "entityProfiles": {
      "description": "An entity profile file, relative to the scene file.",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "fields": {
      "description": "Spatial fields (entity::fieldsFromJson).",
      "x-avgen-untyped": true
    },
    "flight": {
      "description": "ADR-1956.",
      "x-avgen-untyped": true
    },
    "format": {
      "const": "avgen-scene"
    },
    "graph": {
      "description": "A procedural graph file or document.",
      "x-avgen-untyped": true
    },
    "grids": {
      "x-avgen-untyped": true
    },
    "heroes": {
      "description": "Hero points (world::HeroPoint).",
      "x-avgen-note": "an empty list is written as absent, which means the same",
      "x-avgen-untyped": true,
      "x-avgen-writtenBack": false
    },
    "lightRig": {
      "anyOf": [
        {
          "description": "a light rig file, relative to the scene file",
          "type": "string"
        },
        {
          "$ref": "#/$defs/lightRig"
        }
      ],
      "description": "A light rig (ADR-033): a file path or the rig itself; the environment's wins when both name one",
      "x-avgen-note": "written back as environment.lightRig, which the parser also reads",
      "x-avgen-writtenBack": false
    },
    "lights": {
      "description": "Authored lights (ADR-278); each registers lights/<id>/* parameters.",
      "items": {
        "$ref": "#/$defs/light"
      },
      "type": "array",
      "x-avgen-note": "an empty list is written as absent, which means the same",
      "x-avgen-writtenBack": false
    },
    "looks": {
      "description": "ADR-1886: named parameter looks by portal crossing.",
      "x-avgen-untyped": true
    },
    "lunarWorld": {
      "description": "ADR-1882.",
      "x-avgen-untyped": true
    },
    "materialPrograms": {
      "x-avgen-untyped": true
    },
    "meshWire": {
      "description": "ADR-1862.",
      "x-avgen-untyped": true
    },
    "name": {
      "description": "Defaults to the file's stem.",
      "type": "string"
    },
    "navBodyRadius": {
      "description": "Metres; 0 keeps the navigator's default.",
      "maximum": 40.0,
      "minimum": 0.0,
      "type": "number"
    },
    "navCellSize": {
