   "foreground": "the crown of 24 vesica petals and the bead ring, at the frame's edge",
   "focal": "the seed of life and its vermilion core at the exact centre",
   "secondary": [
    "the 12-pointed star",
    "the polygon well",
    "the crown"
   ],
   "atmosphere": "deeper layers dimmer (an indigo depth)",
