{
 "format": "avgen-project",
 "version": 4,
 "app": {
  "name": "PHONOTAXIS"
 },
 "assets": {
  "scene": {
   "kind": "composition",
   "path": "phonotaxis.scene.json"
  },
  "audio": {
   "path": "~/Desktop/All You Got.wav"
  }
 },
 "live": {
  "qualityStrategy": "resolution_first",
  "targetFps": 60
 },
 "parameters": {
  "post/bloom/enabled": true,
  "post/bloom/intensity": 0.5,
  "post/bloom/threshold": 0.9,
  "post/bloom/emissionWeight": 0.8,
  "post/bloom/radius": 0.8,
  "post/tonemap/chroma-retention": 0.65,
  "post/output/vignette": 0.45,
  "post/output/grain": 0.015,
  "post/halation/enabled": true,
  "post/halation/intensity": 0.18,
  "post/halation/warmth": 0.5,
  "post/grade/contrast": 1.08,
  "post/grade/saturation": 1.05,
  "camera/exposure/mode": 0,
  "camera/exposure/compensation": 0.0,
  "temporal/echo/enabled": true,
  "temporal/echo/frames": 8.0,
  "temporal/echo/strength": 0.0,
  "temporal/echo/decay": 0.6
 },
 "routes": [
  {
   "source": "audio.bass",
   "target": "root/scale",
   "op": "add",
   "amount": 0.0
  },
  {
   "source": "audio.mid",
   "target": "root/rotationSpeed",
   "op": "add",
   "amount": 0.0
  },
  {
   "source": "audio.rms",
   "target": "scene/brightness",
   "op": "add",
   "amount": 0.0
  },
  {
   "source": "audio.onset",
   "target": "root/impulse",
   "op": "add",
   "amount": 0.0
  }
 ],
 "render": {
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "output": "sequence",
  "path": "renders/phonotaxis"
 }
}
