 "sonicScene": {
  "category": "abstract",
  "thesis": "Black sand on a resonating plate: every note sings its own standing-wave figure into the sand, and a chord is two figures at war.",
  "composition": {
   "background": "a thin margin of black void round the plate's edge",
   "midground": "a black steel plate filling the frame, seen straight down, the sand gathered on the nodal lines",
   "foreground": "(none: a flat, top-down picture)",
   "focal": "the figure's densest crossing",
   "secondary": [
    "sand leaping off the plate on hits",
    "glitter on the hats"
   ],
   "atmosphere": "(none)",
   "post": "crisp, everything in focus; a slight bloom on the sand; a warm-and-cold grade",
   "camera": "top-down, nearly orthographic (135 mm from 19 m), breathing a few per cent closer and back over 64 s"
  },
  "palette": {
   "dominant": "#0b0b0c",
   "secondary": "#d9cdb6",
   "accent": "#9cc6ff",
   "highlight": "#fff4e2",
   "background_value": "black",
   "saturation": "nearly none: bone sand on black steel, a cold rim"
  },
  "motion": {
   "very_slow": [
    "the camera's breath"
   ],
   "medium": [
    "the figure re-forming as the melody moves"
   ],
   "fast": [
    "sand leaping on notes and kicks"
   ],
   "extremely_fast": [
    "glitter (hat)"
   ]
  },
  "vocabulary": [
   [
    "melodic",
    "notes.lastPitch",
    "the mode numbers: low notes draw simple figures, high notes intricate ones"
   ],
   [
    "timbre",
    "sonic.brightness.slow",
    "with audio alone, the sound's brightness sets the mode: a brighter sound draws a more intricate figure (a played note takes over when it is higher)"
   ],
   [
    "chord",
    "notes.lowest",
    "a second figure from the lowest note is superposed: the figures fight"
   ],
   [
    "sustained",
    "notes.held",
    "a held note sharpens the figure (the nodal lines narrow); silence scatters the sand"
   ],
   [
    "velocity",
    "response.noteEnv",
    "the sand flashes and leaps with the note's strength"
   ],
   [
    "kick",
    "signal.kick",
    "the whole bed leaps, scatters and settles back onto its lines"
   ],
   [
    "snare",
    "response.snare",
    "a burst of sand from the nodes"
   ],
   [
    "hat",
    "response.hat",
    "granular glitter"
   ],
   [
    "bass",
    "response.bass",
    "the plate flexes and the sand swells on its lines"
   ],
   [
    "tension",
    "notes.tension",
    "the figure jitters"
   ]
  ],
  "tier": "light: one plate, one program, two particle systems",
  "id": "cymatic-plate",
  "title": "Cymatic Plate",
