 "sonicScene": {
  "category": "organic",
  "thesis": "The night after the burn: a dead forest still smouldering under a cold sky while the fire front crawls along the far ridge. The bass is the wind breathing on the coals, the snare a tree torching, and every note lifts an ember from the ground where its pitch says.",
  "composition": {
   "background": "the far ridge black against a cold night sky, the fire front a broken line of flame on its crest, its glow in the smoke above",
   "midground": "receding planes of dead pines in cold smoke, rimmed by the fire behind them, their shadows falling toward the camera",
   "foreground": "charred snags close to the lens; a smouldering log and stumps; ash floor pocked with coal beds",
   "focal": "the coal beds and the glowing log in the near ground, against the ridge fire",
   "secondary": [
    "embers rising on the wind",
    "ash falling",
    "glowing cracks low in the trunks"
   ],
   "atmosphere": "low cold smoke, lit warm only near the fire",
   "post": "bloom on the fire, a cold-and-hot grade, grain",
   "camera": "a slow sideways track at head height (90 s there and back), so the tree planes slide in parallax"
  },
  "palette": {
   "dominant": "#060507",
   "secondary": "#2a3040",
   "accent": "#b8bcc4",
   "highlight": "#ff5a00",
   "background_value": "dark, cold (night blue)",
   "saturation": "only what burns is warm; everything else is cold and grey"
  },
  "motion": {
   "very_slow": [
    "the camera's track",
    "the smoke's drift",
    "the ridge fire's growth (sustain)"
   ],
   "medium": [
    "the coal beds breathing (bass)",
    "embers drifting on the wind",
    "ash falling"
   ],
   "fast": [
    "embers lifted by notes",
    "a tree torching (snare)"
   ],
   "extremely_fast": [
    "the crack and throw of sparks (kick)",
    "glints (hat)"
   ]
  },
  "vocabulary": [
   [
    "melodic",
    "response.note",
    "each note lifts an ember from the ground at the pitch's place (low notes left, high notes right); it rises on the heat with a trail"
   ],
   [
    "velocity",
    "notes.lastVelocity",
    "how many embers and how bright"
   ],
   [
    "bass",
    "response.bass",
    "the wind breathes on the coals: the beds and the log glow up, embers stream off downwind, the smoke stirs"
   ],
   [
    "kick",
    "signal.kick",
    "a snag cracks: a throw of sparks from the base of the near snag and its cracks flash"
   ],
   [
    "snare",
    "signal.snare",
    "a tree torches: flame bursts up a midground trunk and lights the smoke"
   ],
   [
    "hat",
    "signal.hat",
    "glints off the coal"
   ],
   [
    "sustained",
    "response.sustain",
    "the fire front on the ridge grows and its glow climbs the sky"
   ],
   [
    "silence",
    "(no input)",
    "a still, smoking forest under a cold sky; the coals breathe faintly; ash falls"
   ]
  ],
  "tier": "medium: a smoke march (16 steps) with the fire's shadows; instanced dead pines; one coal-bed program",
