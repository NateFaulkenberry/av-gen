 "sonicScene": {
  "category": "abstract",
  "thesis": "One immense sheet of iridescent silk, gathered at invisible anchors and spreading broad between them, hangs in a dark void; the music excites it as a resonator: bass bows the sheet, mids crease it, highs run light along its folds, and onsets send wavefronts across it.",
  "composition": {
   "background": "designed darkness: a faint indigo depth behind the focal crease",
   "midground": "the drape falling away and turning into the dark",
   "foreground": "the broad sheet entering huge from the lower left",
   "focal": "the gathered pinch, upper right of centre",
   "camera": "a slow drift, never following the music"
  },
