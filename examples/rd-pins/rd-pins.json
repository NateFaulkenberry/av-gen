 "sonicScene": {
  "category": "experiment",
  "thesis": "A living, illuminated topographic interference field: a bowl of pins in the dark, a reaction-diffusion labyrinth growing over it, its edges drawn as contours of light (a fine hot core, a softer halo, dark channels between). Broad swells heave the field and cross each other; the first bunches and opens the contours and runs beads of light along them on the hats; the bass history rolls out from the heart as a lift and a pool of light; every kick sends a ring of impact across it that swells the contours, carries a band of light and turns the labyrinth toward spots; a busy mix lights it up, a breakdown lets it settle.",
  "experiment": "C reaction-diffusion (production)",
  "id": "rd-pins",
  "title": "RD Pins"
 },
