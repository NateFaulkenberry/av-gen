 "sonicScene": {
  "category": "experiment",
  "thesis": "A bowl of copper pins in the dark. A reaction-diffusion pattern grows over it and lifts every pin it touches; a labyrinth wanders into spots and back; a thin ring of light runs along the pattern's edges. The music never draws on it directly: kicks send rings that turn the labyrinth to spots, held sound widens the spots, bass lifts the field.",
  "experiment": "C reaction-diffusion (production)",
  "id": "rd-pins",
  "title": "RD Pins"
 }
