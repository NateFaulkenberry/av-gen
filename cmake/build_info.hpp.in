#pragma once

// Generated by cmake/GitRevision.cmake at every build. Do not edit; do not commit.
//
// A benchmark number without the revision it was taken on is not comparable with any other
// number, and the audit that opened this work found two Glowmere figures 28% apart with nothing
// recorded that could explain the gap. This is regenerated on every build rather than at configure
// time, because a revision that is stale by fifty commits is worse than no revision at all: it
// invites the comparison it was supposed to make checkable.

#define AVGEN_GIT_REVISION "@AVGEN_GIT_REVISION@"
// True when the working tree had uncommitted changes at build time. A dirty build's measurement
// cannot be reproduced from the revision alone, so it says so.
#define AVGEN_GIT_DIRTY @AVGEN_GIT_DIRTY@
#define AVGEN_GIT_BRANCH "@AVGEN_GIT_BRANCH@"
#define AVGEN_BUILD_TYPE "@AVGEN_BUILD_TYPE@"
