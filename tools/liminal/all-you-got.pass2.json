  {
   "text": "DO YOU WANNA HAVE FUN?",
   "bar": 49,
   "beat": 4.47,
   "t": 109.8,
   "phrase": "verse",
   "line": true,
   "approximate": true
  },
  {
   "text": "AS THE FIRES KEEP BURNING",
   "bar": 50,
   "beat": 3.377,
   "t": 111.4,
   "phrase": "verse",
   "line": true,
   "approximate": true
  },
  {
   "text": "AND THE WORLD STOPS TURNING",
   "bar": 51,
   "beat": 2.465,
   "t": 113.1,
   "phrase": "verse",
   "line": true,
   "approximate": true
  },
  {
   "text": "AND EVERYONE UNDER THE SUN",
   "bar": 52,
   "beat": 1.008,
   "t": 114.5,
   "phrase": "verse",
   "line": true,
   "approximate": true
  },
  {
   "text": "TAKES STEPS IN THE PROCESS TO HEAL AND GROW",
   "bar": 52,
   "beat": 3.552,
   "t": 115.9,
   "phrase": "verse",
   "line": true,
   "approximate": true
  },
  {
